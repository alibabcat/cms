{
  "name": "@kiawosch/backend",
  "version": "1.0.0",
  "description": "KiaWosch CMS backend — Payload CMS + Next.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "codemap": "mkdir -p .codemap && run-s codemap:txt codemap:mmd",
    "codemap:txt": "depcruise src --config ../../.dependency-cruiser.cjs --ts-config tsconfig.codemap.json --output-type text --output-to .codemap/backend.txt",
    "codemap:mmd": "depcruise src --config ../../.dependency-cruiser.cjs --ts-config tsconfig.codemap.json --output-type mermaid --output-to .codemap/backend.mmd",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --port 5000",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev --port 5000",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed/seed.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start --port 5000"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.84.1",
    "@payloadcms/next": "3.84.1",
    "@payloadcms/plugin-ecommerce": "3.84.1",
    "@payloadcms/richtext-lexical": "3.84.1",
    "@payloadcms/translations": "^3.84.1",
    "@payloadcms/ui": "3.84.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.2.6",
    "payload": "3.84.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2",
    "socks-proxy-agent": "^10.0.0"
  },
  "devDependencies": {
    "@kiawosch/eslint-config": "workspace:*",
    "@kiawosch/typescript-config": "workspace:*",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.6",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^10 || ^11"
  }
}
