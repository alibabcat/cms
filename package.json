{
  "name": "kiawosch-cms",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "run-p dev:backend dev:website",
    "dev:backend": "pnpm --filter @kiawosch/backend dev",
    "dev:website": "pnpm --filter @kiawosch/website dev",
    "build": "run-s build:backend build:website",
    "build:backend": "pnpm --filter @kiawosch/backend build",
    "build:website": "pnpm --filter @kiawosch/website build",
    "lint": "run-s lint:backend lint:website",
    "codemap": "run-s codemap:backend codemap:website",
    "codemap:backend": "pnpm --filter @kiawosch/backend codemap",
    "codemap:website": "pnpm --filter @kiawosch/website codemap"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.0.0",
    "npm-run-all": "^4.1.5"
  }
}
